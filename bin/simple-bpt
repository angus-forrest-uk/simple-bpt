#!/usr/bin/env bash
set -euo pipefail

SELF="$(cd "$(dirname "$0")" && pwd)"

for cfg in /etc/simple-bpt/config "${BPT_CONFIG:-}"; do
  if [ -n "$cfg" ] && [ -r "$cfg" ]; then
    # shellcheck disable=SC1090
    . "$cfg"
  fi
done

SERVER="${BPT_SERVER_DIR:-$SELF/bptserver}"
RTI="$SERVER/rti.linux"
BIND="${BPT_BIND:-127.0.0.1}"
PORT="${BPT_PORT:-46729}"

[ -x "$RTI" ] || {
  echo "simple-bpt: no rti.linux at $RTI, run ./build.sh first" >&2
  exit 1
}

if [ -n "${BPT_STATE_DIR:-}" ]; then
  export HOME="$BPT_STATE_DIR"
fi

USERDATA="$HOME/HMRC/payetools-rti/userdata"
mkdir -p "$USERDATA" "$HOME/HMRC/payetools-rti/logs"

if [ ! -e "$USERDATA/sqlite3.db" ]; then
  if [ -e "$SERVER/sqlite3.db" ]; then
    echo "simple-bpt: seeding database in $USERDATA" >&2
    cp "$SERVER/sqlite3.db" "$USERDATA/sqlite3.db"
    chmod u+rw "$USERDATA/sqlite3.db"
  else
    echo "simple-bpt: no seed database at $SERVER/sqlite3.db" >&2
    exit 1
  fi
fi

export LD_LIBRARY_PATH="$SERVER${LD_LIBRARY_PATH:+:$LD_LIBRARY_PATH}"

rti() {
  if [ -n "${BPT_LOADER:-}" ]; then
    "$BPT_LOADER" "$RTI" "$@"
  else
    "$RTI" "$@"
  fi
}

rti startdb >&2

case "$BIND" in
  127.*|localhost|::1) ;;
  *)
    echo "simple-bpt: WARNING $BIND is not loopback, and BPT has no authentication" >&2
    ;;
esac

if [ -n "${BPT_LOADER:-}" ]; then
  exec "$BPT_LOADER" "$RTI" runserver "$BIND:$PORT" --noreload "$@"
fi
exec "$RTI" runserver "$BIND:$PORT" --noreload "$@"
